olor><color name="button_stop">#F44336</color><color name="data_text">#424242</color><color name="title_text">#212121</color><color name="bottom_nav_item_color">@color/primary_color</color></file><file path="C:\SyncData\Code\Android\ContinuousAuthentication\app\src\main\res\values\strings.xml" qualifiers=""><string name="app_name">Continuous Authentication</string><string name="app_description">Secure sensor data collection for continuous authentication research</string><string name="app_version">Version 1.0.0</string><string name="main_title">Continuous Authentication</string><string name="start_collection">Start Collection</string><string name="stop_collection">Stop Collection</string><string name="collection_status">Collection Status</string><string name="status_stopped">Stopped</string><string name="status_running">Running</string><string name="status_paused">Paused</string><string name="status_error">Error</string><string name="sensor_status">Sensor Status</string><string name="accelerometer">Accelerometer</string><string name="gyroscope">Gyroscope</string><string name="magnetometer">Magnetometer</string><string name="sensor_available">Available</string><string name="sensor_unavailable">Unavailable</string><string name="sensor_active">Active</string><string name="sensor_inactive">Inactive</string><string name="network_status">Network Status</string><string name="connection_status">Connection</string><string name="connected">Connected</string><string name="disconnected">Disconnected</string><string name="connecting">Connecting</string><string name="reconnecting">Reconnecting</string><string name="network_quality">Network Quality</string><string name="wifi_excellent">WiFi Excellent</string><string name="wifi_good">WiFi Good</string><string name="wifi_poor">WiFi Poor</string><string name="cellular_excellent">Cellular Excellent</string><string name="cellular_good">Cellular Good</string><string name="cellular_poor">Cellular Poor</string><string name="transmission_status">Transmission Status</string><string name="transmission_mode">Transmission Mode</string><string name="slow_mode">Slow Mode</string><string name="fast_mode">Fast Mode</string><string name="packets_sent">Packets Sent</string><string name="packets_pending">Packets Pending</string><string name="last_ack_latency">Last ACK Latency</string><string name="upload_errors">Upload Errors</string><string name="data_visualization">Data Visualization</string><string name="show_chart">Show Chart</string><string name="hide_chart">Hide Chart</string><string name="chart_accelerometer">Accelerometer Data</string><string name="chart_gyroscope">Gyroscope Data</string><string name="chart_magnetometer">Magnetometer Data</string><string name="x_axis">X</string><string name="y_axis">Y</string><string name="z_axis">Z</string><string name="debug_info">Debug Information</string><string name="device_info">Device Information</string><string name="android_version">Android Version</string><string name="device_model">Device Model</string><string name="keystore_provider">Keystore Provider</string><string name="strongbox_supported">StrongBox Supported</string><string name="sampling_rate">Sampling Rate</string><string name="fifo_size">FIFO Size</string><string name="memory_usage">Memory Usage</string><string name="cpu_usage">CPU Usage</string><string name="privacy_policy">Privacy Policy</string><string name="privacy_agreement_title">Privacy Agreement</string><string name="privacy_agreement_content">This application collects sensor data (accelerometer, gyroscope, magnetometer) and usage statistics for continuous authentication research purposes.\n\n• Data Collection: Motion sensor data is collected only when the device is unlocked and the app is active.\n\n• Data Processing: All data is encrypted immediately using AES-256-GCM encryption before temporary storage.\n\n• Data Storage: Encrypted data is temporarily cached in the app\'s private directory and deleted after successful upload.\n\n• Data Transmission: Data is transmitted securely using TLS 1.3 encryption to research servers.\n\n• Data Usage: Collected data is used solely for academic research on continuous authentication systems.\n\n• Data Sharing: Data is not shared with third parties and is used only for specified research purposes.\n\n• User Rights: You can revoke consent and delete all collected data at any time by uninstalling the application.\n\nBy continuing, you consent to this data collection and processing.</string><string name="accept">Accept</string><string name="decline">Decline</string><string name="agree">Agree</string><string name="disagree">Disagree</string><string name="battery_optimization_title">Battery Optimization</string><string name="battery_optimization_message">To ensure continuous data collection, please disable battery optimization for this app. This allows the app to run in the background and collect sensor data reliably.</string><string name="disable_battery_optimization">Disable Battery Optimization</string><string name="skip">Skip</string><string name="settings">Settings</string><string name="usage_stats_permission_title">Usage Statistics Permission</string><string name="usage_stats_permission_message">This app needs access to usage statistics to identify foreground applications as part of the sensor data context. This helps improve the accuracy of continuous authentication.</string><string name="grant_permission">Grant Permission</string><string name="permission_required">Permission Required</string><string name="permission_denied">Permission Denied</string><string name="permission_granted">Permission Granted</string><string name="error_title">Error</string><string name="error_sensor_initialization">Failed to initialize sensors</string><string name="error_network_connection">Network connection failed</string><string name="error_permission_required">Required permissions not granted</string><string name="error_encryption_failed">Encryption failed</string><string name="error_storage_full">Storage space insufficient</string><string name="error_unknown">Unknown error occurred</string><string name="success_title">Success</string><string name="success_collection_started">Data collection started</string><string name="success_collection_stopped">Data collection stopped</string><string name="success_data_uploaded">Data uploaded successfully</string><string name="success_settings_saved">Settings saved</string><string name="dialog_confirm">Confirm</string><string name="dialog_cancel">Cancel</string><string name="dialog_ok">OK</string><string name="dialog_yes">Yes</string><string name="dialog_no">No</string><string name="settings_title">Settings</string><string name="server_endpoint">Server Endpoint</string><string name="server_endpoint_hint">Enter server URL</string><string name="collection_interval">Collection Interval</string><string name="enable_visualization">Enable Visualization</string><string name="enable_debug_mode">Enable Debug Mode</string><string name="clear_cache">Clear Cache</string><string name="export_logs">Export Logs</string><string name="menu_settings">Settings</string><string name="menu_about">About</string><string name="menu_help">Help</string><string name="menu_privacy">Privacy</string><string name="nav_home">Home</string><string name="nav_status">Status</string><string name="nav_visualization">Visualization</string><string name="nav_settings">Settings</string><string name="unit_ms">ms</string><string name="unit_hz">Hz</string><string name="unit_mb">MB</string><string name="unit_percent">%</string><string name="unit_samples">samples</string><string name="time_now">Now</string><string name="time_seconds_ago">%d seconds ago</string><string name="time_minutes_ago">%d minutes ago</string><string name="time_hours_ago">%d hours ago</string><string name="collection_duration">Collection Duration</string><string name="samples_collected">Samples Collected</string><string name="data_encrypted">Data Encrypted</string><string name="queue_size">Queue Size</string><string name="last_upload">Last Upload</string><string name="privacy_welcome">Welcome to Continuous Authentication. This app is designed for academic research on continuous authentication systems. Please carefully read and accept our privacy policy to continue.</string><string name="privacy_data_collection_title">Data Collection:</string><string name="privacy_data_collection_content">We collect the following data for research purposes:\n• Motion sensors: Accelerometer (200Hz), Gyroscope (200Hz), Magnetometer (100Hz)\n• Device information: Model, Android version, hardware capabilities\n• App usage statistics: Foreground application names (hashed for privacy)\n• Collection occurs only when the device is unlocked and the app has your explicit consent</string><string name="privacy_data_usage_title">Data Usage:</string><string name="privacy_data_usage_content">All collected data is used exclusively for:\n• Academic research on continuous authentication systems\n• Algorithm development and accuracy improvement\n• Statistical analysis of authentication patterns\n• No commercial use or sale of data</string><string name="privacy_data_storage_title">Data Storage &amp; Encryption:</string><string name="privacy_data_storage_content">• Immediate encryption: All sensor data is encrypted using AES-256-GCM before any storage\n• Envelope encryption: Each data packet uses a unique encryption key\n• Temporary cache: Encrypted data may be cached locally for up to 30 days\n• Secure deletion: All local data is securely wiped after successful upload or upon consent withdrawal</string><string name="privacy_data_sharing_title">Data Transmission &amp; Sharing:</string><string name="privacy_data_sharing_content">• Secure transmission: All data is transmitted using TLS 1.3 encryption\n• No third-party sharing: Raw data is never shared with third parties\n• Research use only: Data is transmitted only to authorized research servers\n• Aggregated statistics: Only anonymized, aggregated results may be published</string><string name="privacy_user_rights_title">Your Rights &amp; Controls:</string><string name="privacy_user_rights_content">You have complete control over your data:\n• Withdraw consent: Stop data collection at any time\n• Data deletion: Request complete deletion from both device and servers\n• Data export: Request a copy of your collected data\n• Retention limit: Data is automatically deleted after the configured retention period (default: 30 days)\n• Transparency: View collection status and statistics at any time</string><string name="privacy_contact_title">Contact &amp; Support:</string><string name="privacy_contact_content">For privacy concerns, data requests, or questions:\n• Email: privacy@continuousauth.research\n• Response time: Within 48 hours\n• Data deletion requests processed within 7 days</string><string name="battery_optimization_explanation">To ensure reliable data collection, this app needs to run in the background without battery optimization restrictions.</string><string name="battery_optimization_benefits">Benefits:\n• Consistent sensor data collection\n• Improved authentication accuracy\n• Better research data quality</string><string name="battery_optimization_how_to">Tap \'Disable Optimization\' to open system settings, then find this app and disable battery optimization.</string><string name="disable_optimization">Disable Optimization</string><string name="usage_stats_permission_explanation">This app needs access to usage statistics to collect foreground app information as contextual data.</string><string name="usage_stats_permission_purpose">Purpose: Foreground app names are included in sensor data to provide context for authentication research.</string><string name="usage_stats_permission_privacy">Privacy: App names are encrypted with sensor data and used only for research purposes.</string><string name="usage_stats_permission_steps">Steps: Tap \'Grant Permission\' → Find this app in settings → Enable usage access.</string><string name="sensor_data_visualization">Sensor Data Visualization</string><string name="chart_stats_placeholder">Chart data: 0 points</string><string name="clear_chart">Clear</string><string name="chart_accelerometer_short">Acc</string><string name="chart_gyroscope_short">Gyro</string><string name="chart_magnetometer_short">Mag</string><string name="debug_mode">Debug Mode</string><string name="visualization_mode">Visualization</string><string name="starting">Starting</string><string name="stopping">Stopping</string><string name="nav_sensor_data">Sensor Data</string><string name="nav_server_config">Server Config</string><string name="nav_detailed_info">Detailed Info</string><string name="no_data">No data</string><string name="sensor_charts">Sensor Charts</string><string name="recent_apps">Recent Apps (Last 10)</string><string name="device_id">Device ID</string><string name="tap_to_copy">Tap to copy</string><string name="device_id_copied">Device ID copied to clipboard</string><string name="server_settings">Server Settings</string><string name="server_ip_address">Server IP Address</string><string name="server_port">Server Port</string><string name="test_connection">Test Connection</string><string name="testing_connection">Testing...</string><string name="upload_control">Upload Control</string><string name="upload_description">Start uploading encrypted data to server</string><string name="start_upload">Start Upload</string><string name="stop_upload">Stop Upload</string><string name="stop_upload_title">Stop Upload</string><string name="stop_upload_message">This will stop uploading and clear all unsent data. Continue?</string><string name="stop">Stop</string><string name="cancel">Cancel</string><string name="invalid_port">Invalid port number</string><string name="error_empty_ip">Please enter server IP</string><string name="error_empty_port">Please enter port number</string><string name="error_invalid_port_range">Port must be 1-65535</string><s