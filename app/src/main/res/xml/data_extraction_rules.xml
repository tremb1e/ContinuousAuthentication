<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="user_settings.xml" />
        <include domain="sharedpref" path="server_config.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- A transferred device cannot decrypt the old Android Keystore files. -->
        <include domain="sharedpref" path="user_settings.xml" />
        <include domain="sharedpref" path="server_config.xml" />
    </device-transfer>
</data-extraction-rules>
