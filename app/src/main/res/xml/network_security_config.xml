<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 生产环境gRPC服务器配置 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.continuousauth.com</domain>
        <domain includeSubdomains="true">grpc.continuousauth.com</domain>
        
        <!-- 证书固定配置 (SPKI Pinning) -->
        <pin-set expiration="2026-12-31">
            <!-- 主要证书SHA-256指纹 - 需要替换为实际服务器证书 -->
            <pin digest="SHA-256">7HIpactkIAq2Y49orFOOQKurWxmmSFZhBCoQYcRhJ3Y=</pin>
            <!-- 备用证书指纹，用于证书轮换时的平滑过渡 -->
            <pin digest="SHA-256">YLh1dUR9y6Kja30RrAn7JKnbQG/uEtLMkBgFF2fuihg=</pin>
            <!-- Let's Encrypt备用根证书 -->
            <pin digest="SHA-256">sRHdihwgkaib1P1gxX8HFszlD+7/gTfNvuAybgLPNis=</pin>
        </pin-set>
        
        <trust-anchors>
            <!-- 只信任系统根证书 -->
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
    
    <!-- NTP时间同步服务器配置 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">pool.ntp.org</domain>
        <domain includeSubdomains="false">time.google.com</domain>
        <domain includeSubdomains="false">time.cloudflare.com</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
    
    <!-- 全局安全配置
         说明：默认允许明文流量，用于本地/自建HTTP测试服务器。
         生产域名（上方的 domain-config）仍强制 TLS 并启用证书固定，不受此影响。
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- 生产环境仅信任系统证书 -->
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    
    <!-- 开发环境调试配置 -->
    <debug-overrides>
        <trust-anchors>
            <!-- 开发环境允许用户证书，便于本地测试 -->
            <certificates src="user"/>
            <certificates src="system"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
